# Copy to .env (gitignored). Never commit real values.
# Database credentials do not belong in this repo. Agent API owns MySQL.

# Local `npm start`
API_BASE_URL=http://localhost:3000
STORE_HOST=demo

# `npm run build` — cursor-customer-portal main deploys ONLY to dev.akfusion.com
# Do not point these at api.akfusion.com / akfusion.com.
API_BASE_URL_PRODUCTION=https://dev-api.akfusion.com
STORE_HOST_PRODUCTION=dev.akfusion.com
