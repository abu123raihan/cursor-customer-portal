# Copy to .env (gitignored). Never commit real values.
# Database credentials do not belong in this repo. Agent API owns MySQL.

API_BASE_URL=http://localhost:3000
STORE_HOST=demo

# Used by `npm run build` when set; otherwise falls back to API_BASE_URL.
# Production storefront on Hostinger should call the live Agent API host.
API_BASE_URL_PRODUCTION=https://api.akfusion.com
STORE_HOST_PRODUCTION=akfusion.com
